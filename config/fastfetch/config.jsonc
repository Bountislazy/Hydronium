{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#8ecff2",
      "2": "#c9c1ea",
      "3": "#b5c9d7"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "separator": "#dfe3e7"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "{1}",
      "color": {
        "user": "#8ecff2"
      }
    },
    "break",
    {
      "type": "os",
      "key": "󱄅 os ",
      "keyColor": "#8ecff2"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#c9c1ea"
    },
    {
      "type": "memory",
      "key": "󰘚 ram",
      "keyColor": "#b5c9d7"
    },
    {
      "type": "shell",
      "key": " sh ",
      "keyColor": "#196585"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
