layout {
    gaps 8

    struts {
        left 10
        right 10
        top 10
        bottom 8
    }

    border {
        off
    }

    focus-ring {
        off
    }

    shadow {
        on
        softness 32
        spread 5
        offset x=0 y=6
        color "#000000bb"
        inactive-color "#00000035"
    }
}
